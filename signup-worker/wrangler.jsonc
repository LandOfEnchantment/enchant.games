// The Games page's mailing list (js/signup.js): /api/signup stores an address in D1 and
// /api/unsubscribe deletes one, each behind Turnstile. It sends nothing to anyone. Deployed
// by hand: README.md.
{
  "name": "enchant-games-signup",
  "account_id": "6093bc0889c95a08f0a92a8df6750c66",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Same origin as the pages, so no CORS. Only this address: no workers.dev or preview ones.
  "routes": [
    { "pattern": "enchant.games/api/signup", "zone_name": "enchant.games" },
    { "pattern": "enchant.games/api/unsubscribe", "zone_name": "enchant.games" }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "enchant-games-signups",
      "database_id": "a1fdf1f6-ba08-48b4-b3c7-a84518413668"
    }
  ],
  // 5 tries a minute per IP, before Turnstile, so a flood can't burn its quota.
  "ratelimits": [
    { "name": "SIGNUP_LIMIT", "namespace_id": "4001", "simple": { "limit": 5, "period": 60 } }
  ],
  // TURNSTILE_SECRET is a Worker secret (wrangler secret put TURNSTILE_SECRET), never here.
  "vars": {
    "ALLOWED_ORIGIN": "https://enchant.games",
    "TURNSTILE_HOSTNAME": "enchant.games"
  }
}
